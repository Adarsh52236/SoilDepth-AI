# SoilDepth-AI Git Ignore Specification
# Prevents accidental commits of large satellite, weather, and ground-truth raw archives

# Raw and binary data directories
**/raw/**
*.nc
*.nc4
*.h5
*.hdf
*.tar
*.tar.gz
*.zip
*.7z
*.tif
*.tiff
*.geotiff
*.dem
*.hgt
*.vrt
*.asc
*.bin

# Python environment & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.env
venv/
.venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# System & OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary / scratch directory
scratch/
tmp/

# Generated intermediate datasets
data/modelling/**

# ISMN bulk station extractions (keep only AAMU-JTG station files)
dataset/ISMN/IIT_KANPUR/extracted/**
dataset/ISMN/SCAN/extracted/*/*/*
!dataset/ISMN/SCAN/extracted/*/*/AAMU-JTG
!dataset/ISMN/SCAN/extracted/*/*/AAMU-JTG/**
